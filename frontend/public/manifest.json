{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "com.carlog.app",
  "name": "CarLog — Registro y Catálogo de Autos",
  "short_name": "CarLog",
  "description": "Escanea y registra autos en la calle con Inteligencia Artificial, consulta sus especificaciones reales y construye tu colección en 3D.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#06070a",
  "theme_color": "#0a0a0c",
  "lang": "es-AR",
  "dir": "ltr",
  "categories": [
    "auto",
    "entertainment",
    "games",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Escanear Auto",
      "short_name": "Cámara",
      "description": "Abre el visor de cámara para identificar un auto en la calle",
      "url": "/#camera",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Garage 3D",
      "short_name": "Garage",
      "description": "Explora tu colección de marcas en el taller 3D",
      "url": "/#garage",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Radar de Autos",
      "short_name": "Radar",
      "description": "Consulta alertas de autos raros cercanos",
      "url": "/#radar",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/#camera",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photo",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
